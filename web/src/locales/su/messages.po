msgstr "Anjeun rék ngahapus halaman <0>\"{title}\"</0> ({slug}). Aksi ieu tiasa dibatalkeun ku malikkeun deui ti riwayat."

#: src/features/wiki/revert-page.tsx
msgid "You are about to revert <0>{slug}</0> to version <1>{version}</1>. This will create a new revision with the content from version {version}."
msgstr "Anjeun rék mulangkeun <0>{slug}</0> ka versi <1>{version}</1>. Ieu bakal nyieun révisi anyar maké eusi ti versi {version}."

#: ../../../lib/web/src/features/errors/general-error.tsx
msgid "You do not have access to this section."
msgstr "Anjeun teu gaduh aksés kana bagian ieu."

#: ../../../lib/web/src/components/restore-banner.tsx
msgid "Your account was moved here from {source}. Until you delete it there, messages and notifications may reach both servers, some of your content keeps being served from the old server, and followers may take a few minutes to find you here."
msgstr "Akun anjeun dipindahkeun ka dieu ti {source}. Dugi ka anjeun mupus éta di ditu, pesen jeung béwara tiasa dugi ka dua server, sababaraha konten anjeun tetep disajikan ti server lami, sareng pangéntép tiasa butuh sababaraha menit pikeun mendakan anjeun di dieu."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your attachments will be lost."
msgstr "Lampiran anjeun bakal leungit."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text and attachments will be lost."
msgstr "Téks sareng lampiran anjeun bakal leungit."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text will be lost."
msgstr "Téks anjeun bakal leungit."
