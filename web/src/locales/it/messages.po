msgstr "Stai per eliminare la pagina <0>«{title}»</0> ({slug}). Questa azione può essere annullata ripristinando dalla cronologia."

#: src/features/wiki/revert-page.tsx
msgid "You are about to revert <0>{slug}</0> to version <1>{version}</1>. This will create a new revision with the content from version {version}."
msgstr "Stai per ripristinare <0>{slug}</0> alla versione <1>{version}</1>. Questo creerà una nuova revisione con il contenuto della versione {version}."

#: ../../../lib/web/src/features/errors/general-error.tsx
msgid "You do not have access to this section."
msgstr "Non hai accesso a questa sezione."

#: ../../../lib/web/src/components/restore-banner.tsx
msgid "Your account was moved here from {source}. Until you delete it there, messages and notifications may reach both servers, some of your content keeps being served from the old server, and followers may take a few minutes to find you here."
msgstr "Il tuo account è stato spostato qui da {source}. Finché non lo elimini lì, i messaggi e le notifiche possono raggiungere entrambi i server, parte dei tuoi contenuti continua a essere servita dal vecchio server e i follower potrebbero impiegare qualche minuto per trovarti qui."

