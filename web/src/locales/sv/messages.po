msgstr "Skriv ditt innehåll här med Markdown..."

#: src/features/wiki/delete-page.tsx
msgid "You are about to delete the page <0>\"{title}\"</0> ({slug}). This action can be undone by restoring from history."
msgstr "Du är på väg att ta bort sidan <0>”{title}”</0> ({slug}). Åtgärden kan ångras genom att återställa från historiken."

#: src/features/wiki/revert-page.tsx
msgid "You are about to revert <0>{slug}</0> to version <1>{version}</1>. This will create a new revision with the content from version {version}."
msgstr "Du är på väg att återställa <0>{slug}</0> till version <1>{version}</1>. Detta skapar en ny revision med innehållet från version {version}."

#: ../../../lib/web/src/features/errors/general-error.tsx
msgid "You do not have access to this section."
msgstr "Du har inte åtkomst till det här avsnittet."

#: ../../../lib/web/src/components/restore-banner.tsx
msgid "Your account was moved here from {source}. Until you delete it there, messages and notifications may reach both servers, some of your content keeps being served from the old server, and followers may take a few minutes to find you here."
msgstr "Ditt konto flyttades hit från {source}. Tills du tar bort det där kan meddelanden och notiser nå båda servrarna, en del av ditt innehåll fortsätter att levereras från den gamla servern och följare kan behöva några minuter för att hitta dig här."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your attachments will be lost."
msgstr "Dina bilagor går förlorade."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text and attachments will be lost."
msgstr "Din text och dina bilagor går förlorade."

#: ../../../lib/web/src/components/comment-composer.tsx
msgid "Your text will be lost."
msgstr "Din text kommer att försvinna."
